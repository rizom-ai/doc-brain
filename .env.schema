# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/bitwarden-plugin@1.0.0)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ----------

# Bitwarden bootstrap token supplied by shell/CI
# @required @sensitive @type=bitwardenAccessToken
BWS_ACCESS_TOKEN=

# AI provider
# @required @sensitive
AI_API_KEY=bitwarden("96c6c0ba-58b1-4c59-b7bf-b4400072f0ca")

# Optional: separate key for image generation (defaults to AI_API_KEY)
# @sensitive
AI_IMAGE_KEY=

# Git sync
# @required @sensitive
GIT_SYNC_TOKEN=bitwarden("dc3d737f-6877-48f9-bc30-b4400072f9ea")

# Interfaces
# @sensitive
DISCORD_BOT_TOKEN=bitwarden("7b87a004-1146-41bf-93e4-b44000730302")

# ---- deploy/provision vars (written by brain init --deploy) ----

# @required @sensitive
HCLOUD_TOKEN=bitwarden("8fc9e14c-3189-4409-a8ce-b44000730386")

# @required
HCLOUD_SSH_KEY_NAME=bitwarden("d9028f08-a86e-4127-9a04-b440007303dd")

# @required
HCLOUD_SERVER_TYPE=bitwarden("c55df28c-8796-4119-97c9-b44000730436")

# @required
HCLOUD_LOCATION=bitwarden("37b0783c-c12f-4faa-a684-b44000730490")

# @required @sensitive
KAMAL_SSH_PRIVATE_KEY=bitwarden("20a0f868-f377-486d-b58f-b4400076a95a")

# @required @sensitive
KAMAL_REGISTRY_PASSWORD=bitwarden("c016847f-1521-470c-9c62-b440007304ef")

# @required @sensitive
CF_API_TOKEN=bitwarden("7104a373-e31e-4fb4-bf91-b44000730548")

# @required
CF_ZONE_ID=bitwarden("1da0296b-a39b-40c7-bdbe-b440007305a5")

# ---- TLS cert vars (written by brain cert:bootstrap, consumed by kamal-proxy) ----

# @required @sensitive
CERTIFICATE_PEM=bitwarden("4676fa89-364e-4489-8c9b-b4400076a9b5")

# @required @sensitive
PRIVATE_KEY_PEM=bitwarden("dd6b0d6f-1058-4677-b177-b4400076aa12")
